#!/bin/sh
#
# SPDX-License-Identifier: MIT
#

### BEGIN INIT INFO
# Provides:          tgbs-cgroup2
# Required-Start:    mountvirtfs $local_fs
# Required-Stop:     $local_fs
# Default-Start:     S
# Default-Stop:      0 6
# Short-Description: Mount cgroup v2 and enable TGBS resource controllers.
# Description:       Prepare the cgroup v2 hierarchy at /sys/fs/cgroup so that
#                    TGBS can create and place task groups under the root, and
#                    initialize the volatile communication-channel store. Does
#                    not create any subgroup or modify a temporal contract.
### END INIT INFO

CG_ROOT=/sys/fs/cgroup
RUN_ROOT=/run/tgbs
CHANNEL_ROOT=$RUN_ROOT/channels
CHANNEL_TOPOLOGY_LOCK=$RUN_ROOT/.channel-topology.lock

case "${1:-start}" in
	start|restart|force-reload)
		;;
	stop)
		# cgroupfs is unmounted with the other local virtual filesystems.
		exit 0
		;;
	*)
		echo "Usage: $0 {start|stop|restart|force-reload}" >&2
		exit 2
		;;
esac

# /proc and /sys are provided by sysfs.sh (S02). A missing /proc/mounts means
# the boot environment is not ready.
if [ ! -r /proc/mounts ]; then
	echo "tgbs: ERROR - /proc/mounts is missing, boot environment is incomplete" >&2
	exit 1
fi

mkdir -p "$CG_ROOT"
mkdir -p "$RUN_ROOT"
mkdir -p "$CHANNEL_ROOT"
touch "$CHANNEL_TOPOLOGY_LOCK"
chmod 0755 "$CHANNEL_ROOT"
chmod 0600 "$CHANNEL_TOPOLOGY_LOCK"

# Three cases for /sys/fs/cgroup:
#  - nothing mounted there: mount cgroup2;
#  - already mounted as cgroup2: continue;
#  - mounted with any other type: fail, never mount cgroup2 on top.
if mountpoint -q "$CG_ROOT"; then
	if ! awk '$2=="/sys/fs/cgroup" && $3=="cgroup2"{found=1} END{exit !found}' /proc/mounts; then
		echo "tgbs: ERROR - $CG_ROOT is already mounted with a non-cgroup2 filesystem; refusing to mount cgroup2 on top" >&2
		exit 1
	fi
else
	mount -t cgroup2 cgroup2 "$CG_ROOT"
	if [ $? -ne 0 ]; then
		echo "tgbs: ERROR - unable to mount cgroup2 on $CG_ROOT" >&2
		exit 1
	fi
fi

# The unified hierarchy must expose cgroup.controllers.
if [ ! -r "$CG_ROOT/cgroup.controllers" ]; then
	echo "tgbs: ERROR - $CG_ROOT/cgroup.controllers is missing, the unified hierarchy is unavailable" >&2
	exit 1
fi

# TGBS uses cpu for temporal contracts, cpuset for placement, and memory and
# pids to bound the resources available to each managed domain.
for controller in cpu cpuset memory pids; do
	if ! grep -w -q "$controller" "$CG_ROOT/cgroup.controllers"; then
		echo "tgbs: ERROR - the $controller controller is not available in $CG_ROOT/cgroup.controllers" >&2
		exit 1
	fi

	if ! grep -w -q "$controller" "$CG_ROOT/cgroup.subtree_control" 2>/dev/null; then
		if ! echo "+$controller" > "$CG_ROOT/cgroup.subtree_control"; then
			echo "tgbs: ERROR - unable to enable +$controller in $CG_ROOT/cgroup.subtree_control" >&2
			exit 1
		fi
	fi
done

echo "tgbs: cgroup v2 is ready at $CG_ROOT, cpu, cpuset, memory, and pids enabled at the root"
exit 0
