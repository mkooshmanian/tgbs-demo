#!/bin/sh
#
# SPDX-License-Identifier: MIT
#
# Run as PID 1 via init=/sbin/tgbs-preinit, before SysV init opens /etc.
# The original root mount stays read-only at /rofs. Every writable root,
# including the host's, uses its own upper rather than another live overlay.

set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

trap 'echo "tgbs-preinit: ERROR - root overlay setup failed; refusing to start init" >&2' 0

[ "$$" -eq 1 ] || {
	echo "tgbs-preinit: ERROR - must run as PID 1" >&2
	exit 1
}

# All mountpoints are installed in the image; never remount the base writable
# to prepare them. /dev is normally already provided by CONFIG_DEVTMPFS_MOUNT.
[ -e /dev/console ] || mount -n -t devtmpfs devtmpfs /dev
mount -n -t proc proc /proc
mount -n -t sysfs sysfs /sys
# BusyBox consults /proc/mounts to resolve a remount of /.
mount -n -o remount,ro /
mount --make-rprivate /

# /run is only a staging mount here. Move it outside /rofs after pivot_root,
# so /rofs contains no writable submounts and SysV can mount its usual /run.
mount -n -t tmpfs -o mode=0700,nosuid,nodev tmpfs /run
mkdir -m 0700 /run/upper /run/work /run/merged
mount -n -t overlay -o lowerdir=/,upperdir=/run/upper,workdir=/run/work overlay /run/merged
mkdir -p /run/merged/rofs /run/merged/.tgbs-overlay
chmod 0700 /run/merged/.tgbs-overlay

# These mounts are independent of the base and must remain available to init.
mount -n --move /dev /run/merged/dev
mount -n --move /proc /run/merged/proc
mount -n --move /sys /run/merged/sys
pivot_root /run/merged /run/merged/rofs
cd /
mount -n --move /rofs/run /.tgbs-overlay

# read-only-rootfs configures SysV for a read-only /. Here it is the original
# filesystem at /rofs that is read-only; the new / is a writable overlay.
# Change only the host upper, leaving the shared image untouched. In particular,
# checkroot must neither fsck the overlay nor remount it read-only at S05.
sed -i '/^[^#[:space:]][^[:space:]]*[[:space:]][[:space:]]*\/[[:space:]]/c\overlay / overlay rw 0 0' /etc/fstab
sed -i 's/^ROOTFS_READ_ONLY=yes$/ROOTFS_READ_ONLY=no/' /etc/default/rcS

echo "tgbs-preinit: writable tmpfs overlay ready; static rootfs at /rofs"
exec /sbin/init "$@"
