#!/bin/sh
#
# SPDX-License-Identifier: MIT
#
# Run as PID 1 before SysV init. Both the system and containers have independent
# persistent uppers over the same read-only image.

set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
umask 077

trap 'echo "tgbs-preinit: ERROR - root overlay setup failed; refusing to start init" >&2' 0
[ "$$" -eq 1 ] || exit 1

STORE=/var/lib/tgbs
RUNTIME=/run/tgbs/rootfs
STATE_DEVICE=LABEL=tgbs-state

[ -e /dev/console ] || mount -n -t devtmpfs devtmpfs /dev
mount -n -t proc proc /proc
mount -n -t sysfs sysfs /sys
mount -n -o remount,ro /
mount --make-rprivate /

for argument in $(cat /proc/cmdline); do
	case "$argument" in
		tgbs.state=*) STATE_DEVICE=${argument#tgbs.state=} ;;
	esac
done

# The mountpoint is installed in the image. Never format a device at boot.
mount -n -t ext4 -o nosuid,nodev "$STATE_DEVICE" "$STORE"
chmod 0700 "$STORE"
image_id=$(cat /etc/tgbs-rootfs-id)
[ "${#image_id}" -eq 64 ]
if [ -e "$STORE/rootfs-id" ]; then
	[ ! -L "$STORE/rootfs-id" ]
	if [ "$(cat "$STORE/rootfs-id")" != "$image_id" ]; then
		echo "tgbs-preinit: ERROR - persistent overlays belong to another rootfs image" >&2
		exit 1
	fi
else
	# Do not adopt existing uppers whose base cannot be identified.
	[ ! -e "$STORE/overlays" ]
	[ ! -L "$STORE/rootfs-id.tmp" ]
	printf '%s\n' "$image_id" > "$STORE/rootfs-id.tmp"
	sync
	mv "$STORE/rootfs-id.tmp" "$STORE/rootfs-id"
	sync
fi
mkdir -p "$STORE/overlays/system/upper" "$STORE/overlays/system/work" "$STORE/overlays/containers"

# Retain only the static filesystem, without its submounts. The first /run
# serves as temporary staging and is discarded after the pivot.
mount -n -t tmpfs -o mode=0700,nosuid,nodev tmpfs /run
mkdir /run/base /run/merged
mount -n --bind / /run/base
mount -n -t overlay -o "lowerdir=/run/base,upperdir=$STORE/overlays/system/upper,workdir=$STORE/overlays/system/work" overlay /run/merged

# Prepare the final /run before pivoting. SysV's mount -a keeps this mount.
mount -n -t tmpfs -o mode=0755,nosuid,nodev,strictatime tmpfs /run/merged/run
mkdir -p "/run/merged$RUNTIME/base" "/run/merged$RUNTIME/old-root"
chmod 0755 /run/merged/run/tgbs "/run/merged$RUNTIME"
mount -n --move /run/base "/run/merged$RUNTIME/base"
mount -n --move /dev /run/merged/dev
mount -n --move /proc /run/merged/proc
mount -n --move /sys /run/merged/sys
pivot_root /run/merged "/run/merged$RUNTIME/old-root"
cd /
mount -n --move "$RUNTIME/old-root$STORE" "$STORE"
umount -l "$RUNTIME/old-root"
rmdir "$RUNTIME/old-root"

# Adjust only the system upper: never fsck the overlay or remount it read-only.
sed -i '/^[^#[:space:]][^[:space:]]*[[:space:]][[:space:]]*\/[[:space:]]/c\overlay / overlay rw 0 0' /etc/fstab
sed -i 's/^ROOTFS_READ_ONLY=yes$/ROOTFS_READ_ONLY=no/' /etc/default/rcS

echo "tgbs-preinit: persistent system overlay ready; static base at $RUNTIME/base"
exec /sbin/init "$@"
