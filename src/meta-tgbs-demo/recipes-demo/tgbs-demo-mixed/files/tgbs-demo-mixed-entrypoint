#!/bin/sh

set -eu

[ "$#" -eq 1 ] || {
    echo "Usage: mixed-entrypoint CONFIG" >&2
    exit 1
}

CONFIG="$1"
PIDS=""

cleanup()
{
    trap - EXIT INT TERM

    for pid in ${PIDS}; do
        kill "${pid}" 2>/dev/null || true
    done

    wait 2>/dev/null || true
}

trap cleanup EXIT INT TERM

TASKS=$(jq -r '
    .system.subsystems[0].tasks[] |
    if .type == "TaskRT" then
        [.type, .name, .execution_time, .period, .policy, .priority]
    else
        [.type, .name, .execution_time, "-", .policy, "-"]
    end |
    @tsv
' "${CONFIG}")

while IFS="$(printf '\t')" read -r type name execution_time period policy priority; do
    case "${type}:${policy}" in
        TaskRT:FIFO)
            echo "Starting ${name}: periodic FIFO, C=${execution_time} ms, T=${period} ms, priority=${priority}"
            fake-task \
                -w \
                --periodic \
                --sched=fifo \
                --prio="${priority}" \
                "${period}" "${execution_time}" &
            ;;
        TaskQoS:OTHER)
            echo "Starting ${name}: continuous FAIR, C=${execution_time} ms"
            fake-task \
                -w \
                --continuous \
                --sched=fair \
                "${execution_time}" &
            ;;
        *)
            echo "Unsupported task ${name}: type=${type}, policy=${policy}" >&2
            exit 1
            ;;
    esac

    PIDS="${PIDS} $!"
done <<EOF
${TASKS}
EOF

sleep 0.2

for pid in ${PIDS}; do
    kill -USR1 "${pid}"
done

wait
