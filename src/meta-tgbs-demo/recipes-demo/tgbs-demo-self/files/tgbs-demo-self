#!/bin/sh

set -eu

DOMAIN="self"
ENTRYPOINT="/usr/libexec/tgbs-demo/self-entrypoint"
SHARED_HOST="/home/root/shared"
SHARED_CONTAINER="/mnt/shared"

RUNTIME_US=50000
PERIOD_US=100000
CPUS="0"

usage()
{
    cat <<EOF
Usage:
  tgbs-demo-self [start]

With no arguments, runs 'start'.

Open an interactive shell inside the '${DOMAIN}' TGBS domain.
Leave the container and remove its domain with 'exit' or Ctrl-D.
The host's ${SHARED_HOST} is shared at ${SHARED_CONTAINER} in the container.
Files remain available on the host after the container exits.

TGBS contract:
  runtime:  ${RUNTIME_US} us
  period:   ${PERIOD_US} us
  cpus:     ${CPUS}
EOF
}

if [ "$#" -eq 0 ]; then
    set -- start
fi

case "${1:-}" in
    start)
        [ "$#" -eq 1 ] || {
            usage
            exit 1
        }

        mkdir -p "${SHARED_HOST}"
        echo "Entering the '${DOMAIN}' TGBS container."
        echo "Shared directory: ${SHARED_HOST} (host) -> ${SHARED_CONTAINER} (container)."
        exec tgbsctl run \
            --name "${DOMAIN}" \
            --hostname tgbs-self \
            --runtime-us "${RUNTIME_US}" \
            --period-us "${PERIOD_US}" \
            --cpus "${CPUS}" \
            --bind "${SHARED_HOST}:${SHARED_CONTAINER}" \
            "${ENTRYPOINT}"
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        usage
        exit 1
        ;;
esac
