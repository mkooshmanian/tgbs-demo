#!/bin/sh

# Lightweight fastfetch-style summary tailored to the TGBS demo image.

set -u

usage()
{
    cat <<EOF
Usage: tgbs-fetch [--no-color]

Display a compact summary of the TGBS demo system.
EOF
}

use_color=0
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] && [ -z "${NO_COLOR:-}" ]; then
    use_color=1
fi

case "${1:-}" in
    "") ;;
    --no-color) use_color=0 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

if [ "${use_color}" -eq 1 ]; then
    cyan='\033[36m'
    bold='\033[1m'
    dim='\033[2m'
    reset='\033[0m'
else
    cyan=''
    bold=''
    dim=''
    reset=''
fi

host=$(hostname 2>/dev/null || uname -n)
kernel=$(uname -r)
architecture=$(uname -m)
os_name="TGBS demonstration distribution"
if [ -r /etc/os-release ]; then
    # This file is generated by the image build and contains shell-safe
    # assignments as specified by os-release(5).
    . /etc/os-release
    os_name=${PRETTY_NAME:-${NAME:-$os_name}}
fi

cpu_count=0
while read -r field _; do
    case "$field" in
        cpu[0-9]*) cpu_count=$((cpu_count + 1)) ;;
    esac
done < /proc/stat
[ "${cpu_count}" -gt 0 ] || cpu_count=1

cpu_model=""
while IFS=: read -r key value; do
    case "$key" in
        *"model name"*|Processor*|Hardware*)
            cpu_model=$(printf '%s' "$value" |
                sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            [ -n "$cpu_model" ] && break
            ;;
    esac
done < /proc/cpuinfo
[ -n "$cpu_model" ] || cpu_model="$architecture processor"

mem_total_kb=0
mem_available_kb=0
mem_free_kb=0
while read -r key value _; do
    case "$key" in
        MemTotal:) mem_total_kb=$value ;;
        MemAvailable:) mem_available_kb=$value ;;
        MemFree:) mem_free_kb=$value ;;
    esac
done < /proc/meminfo
[ "${mem_available_kb}" -gt 0 ] || mem_available_kb=$mem_free_kb
mem_total_mb=$((mem_total_kb / 1024))
mem_used_mb=$(((mem_total_kb - mem_available_kb) / 1024))
memory="${mem_used_mb} MiB / ${mem_total_mb} MiB"

read -r uptime_value _ < /proc/uptime
uptime_seconds=${uptime_value%%.*}
uptime_days=$((uptime_seconds / 86400))
uptime_hours=$(((uptime_seconds % 86400) / 3600))
uptime_minutes=$(((uptime_seconds % 3600) / 60))
if [ "${uptime_days}" -gt 0 ]; then
    uptime="${uptime_days}d ${uptime_hours}h ${uptime_minutes}m"
else
    uptime="${uptime_hours}h ${uptime_minutes}m"
fi

tgbs_status="not detected"
if [ -r /sys/fs/cgroup/cpu.runtime_us ] &&
   [ -r /sys/fs/cgroup/cpu.period_us ]; then
    tgbs_status="enabled"
elif [ -r /sys/fs/cgroup/cgroup.controllers ] &&
     grep -qw cpu /sys/fs/cgroup/cgroup.controllers 2>/dev/null; then
    tgbs_status="cgroup CPU controller ready"
fi

domain_count=0
for marker in /run/tgbs/*/main.pid; do
    [ -f "$marker" ] || continue
    domain_count=$((domain_count + 1))
done

logo1=' _______  ____  ____  ____  '
logo2='|_   _| / ___|| __ )/ ___| '
logo3='  | |  | |  _ |  _ \___ \ '
logo4='  | |  | |_| || |_) |___) | '
logo5='  |_|   \____||____/|____/  '
blank='                            '

line()
{
    printf '%b%-28s%b  %b%-9s%b %s\n' \
        "$cyan" "$1" "$reset" "$bold" "$2" "$reset" "$3"
}

printf '\n'
line "$logo1" "Host" "$host"
line "$logo2" "OS" "$os_name"
line "$logo3" "Kernel" "$kernel"
line "$logo4" "Arch" "$architecture"
line "$logo5" "CPU" "${cpu_count} x ${cpu_model}"
line "$blank" "Memory" "$memory"
line "$blank" "Uptime" "$uptime"
line "$blank" "TGBS" "$tgbs_status"
line "$blank" "Domains" "$domain_count active"
printf '%b%s%b\n\n' "$dim" \
    'Commands: tgbsctl · tgbs-demo-top · tgbs-demo-mixed-timeline' "$reset"
