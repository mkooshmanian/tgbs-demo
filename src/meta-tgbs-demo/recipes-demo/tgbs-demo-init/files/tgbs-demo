#!/bin/sh
# SPDX-License-Identifier: MIT

### BEGIN INIT INFO
# Provides:          tgbs-demo
# Required-Start:    $local_fs $network tgbs-cgroup2
# Required-Stop:     $local_fs tgbs-cgroup2
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Launch the TGBS demonstration domains.
### END INIT INFO

set -eu

CONFIG=/etc/tgbs-demo/launcher.json
LOG_DIR=/var/log/tgbs-demo
LOG=$LOG_DIR/launcher.log

start()
{
    echo "Launching TGBS demonstration domains"
    mkdir -p "$LOG_DIR"
    if ! tgbs-launcher "$CONFIG" </dev/null >>"$LOG" 2>&1; then
        echo "tgbs-demo: launch failed; see $LOG" >&2
        return 1
    fi
}

stop()
{
    echo "Stopping TGBS demonstration domains"
    domains=$(jq -r '.domains[].name' "$CONFIG")
    channels=$(jq -r '.channels[]?.name' "$CONFIG")
    result=0

    for domain in $domains; do
        if tgbsctl inspect "$domain" >/dev/null 2>&1; then
            tgbsctl kill "$domain" || result=1
        fi
    done

    # Workers finish their own cleanup before the channel contracts are removed.
    count=0
    while :; do
        active=0
        for domain in $domains; do
            if tgbsctl inspect "$domain" >/dev/null 2>&1; then
                active=1
            fi
        done
        [ "$active" = 1 ] || break
        count=$((count + 1))
        if [ "$count" -ge 50 ]; then
            echo "tgbs-demo: timed out waiting for domains to stop" >&2
            return 1
        fi
        sleep 0.1
    done

    for channel in $channels; do
        if tgbsctl channel inspect "$channel" >/dev/null 2>&1; then
            tgbsctl channel delete "$channel" || result=1
        fi
    done
    return "$result"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart|force-reload) stop; start ;;
    *) echo "Usage: $0 {start|stop|restart|force-reload}" >&2; exit 2 ;;
esac
